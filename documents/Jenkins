pipeline {

    agent any

    stages {

        stage('Checkout') {
            steps {
                git 'https://github.com/company/employee-service.git'
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean package'
            }
        }

        stage('SonarQube') {
            steps {
                sh 'mvn sonar:sonar'
            }
        }

        stage('Docker Build') {
            steps {
                sh 'docker build -t employee-service .'
            }
        }

        stage('Push to ECR') {
            steps {
                sh '''
                   docker tag employee-service:latest \
                   ACCOUNT_ID.dkr.ecr.ap-south-1.amazonaws.com/employee-service:latest

                   docker push \
                   ACCOUNT_ID.dkr.ecr.ap-south-1.amazonaws.com/employee-service:latest
                '''
            }
        }

        stage('Deploy ECS') {
            steps {
                sh '''
                   aws ecs update-service \
                   --cluster my-cluster \
                   --service employee-service \
                   --force-new-deployment
                '''
            }
        }
    }
}